{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/images/profile-picture.jpg",
        "headers": [{ "key": "Content-Type", "value": "image/png" }]
      }
    ]
  },
  "emulators": {
    "hosting": { "host": "127.0.0.1", "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
